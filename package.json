    "commander": "^15.0.0",
    "iconv-lite": "^0.7.3",
    "sprintf-js": "^1.1.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sanori/node-unzip-mbcs.git"
