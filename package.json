  "description": "UnZip for non-UTF8 encoding such as cp949, sjis, gbk, euc-kr, euc-jp, and gb2312",
  "type": "commonjs",
  "main": "unzip-mbcs.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "pretest": "biome lint .",
    "test": "node --test"
  },
